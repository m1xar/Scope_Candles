MT5_CANDLES_CLICKHOUSE_HOST=localhost
MT5_CANDLES_CLICKHOUSE_PORT=8123
MT5_CANDLES_CLICKHOUSE_USER=candles
MT5_CANDLES_CLICKHOUSE_PASSWORD=candles_pass
MT5_CANDLES_CLICKHOUSE_DATABASE=candles

MT5_CANDLES_REDIS_URL=redis://localhost:6379/0

MT5_CANDLES_MT5_LOGIN=
MT5_CANDLES_MT5_PASSWORD=
MT5_CANDLES_MT5_SERVER=MetaQuotes-Demo

MT5_CANDLES_CANDLES_TERMINAL_PATH=C:\MT5\c1\terminal64.exe
MT5_CANDLES_PRICE_TERMINAL_PATH=C:\MT5\c2\terminal64.exe
MT5_CANDLES_TERMINAL_PORTABLE=true
MT5_CANDLES_TERMINAL_INIT_TIMEOUT_MS=60000
MT5_CANDLES_TERMINAL_LOGIN_TIMEOUT_MS=30000

MT5_CANDLES_BACKFILL_INTERVAL_MINUTES=15
MT5_CANDLES_BACKFILL_CHUNK_DAYS=30
MT5_CANDLES_BACKFILL_START_DATE=
MT5_CANDLES_SYMBOL_HISTORY_RETRIES=3
# Hole repair: every N hours re-read the last N days and insert only missing minutes.
# REPAIR_SINCE (ISO date) widens the first repair after a restart, e.g. to fill old holes once.
MT5_CANDLES_REPAIR_INTERVAL_HOURS=6
MT5_CANDLES_REPAIR_LOOKBACK_DAYS=7
MT5_CANDLES_REPAIR_SINCE=
# Broker catalogue refresh: new symbols are queued for backfill, vanished ones marked delisted.
MT5_CANDLES_CATALOG_REFRESH_HOURS=24
MT5_CANDLES_CATALOG_MIN_RATIO=0.5
# History backfill of new symbols runs after each regular pass within this budget.
MT5_CANDLES_BACKFILL_BUDGET_SECONDS=240
MT5_CANDLES_BACKFILL_PAUSE_SECONDS=0.5
MT5_CANDLES_PRUNE_CACHE=false

MT5_CANDLES_TICK_POLL_MS=300
MT5_CANDLES_PRICE_TTL_SECONDS=300

MT5_CANDLES_SYMBOL_SUFFIXES=
MT5_CANDLES_SYMBOL_INCLUDE_PATH_PREFIXES=Forex,Metals,Indexes,Commodities,Crypto,Indices
# Stocks/ETFs: off by default. MetaQuotes-Demo lists ~12 000; take an allowlist, capped.
MT5_CANDLES_SYMBOL_EXTRA_PATH_PREFIXES=Nasdaq\Stock,NYSE\Stock,ETF
MT5_CANDLES_SYMBOL_EXTRA_ALLOWLIST=
MT5_CANDLES_SYMBOL_EXTRA_MAX=0

MT5_CANDLES_MAX_ROWS=50000
MT5_CANDLES_FRESHNESS_LAG_MINUTES=15

MT5_CANDLES_API_TOKEN=
MT5_CANDLES_API_HOST=0.0.0.0
MT5_CANDLES_API_PORT=8040

MT5_CANDLES_WORKER_START_TIMEOUT_SECONDS=180
MT5_CANDLES_WORKER_HEARTBEAT_TIMEOUT_SECONDS=900

MT5_CANDLES_LOG_LEVEL=INFO
MT5_CANDLES_LOG_JSON=true
